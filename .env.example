# VITE_API_BASE_URL: Base URL for Synvora IT backend REST API endpoints
# Leave empty or set to /api for relative proxying in dev, or e.g. https://api.synvorait.com
VITE_API_BASE_URL="/api"

# VITE_INQUIRY_WEBHOOK_URL: Optional external webhook for project leads (e.g. Zapier, Make, Slack)
VITE_INQUIRY_WEBHOOK_URL=""

# VITE_CLIENT_PORTAL_AUTH_DOMAIN: Domain for enterprise SSO authentication (e.g. auth.synvorait.com)
VITE_CLIENT_PORTAL_AUTH_DOMAIN=""
